{
    "name": "@elizaos/plugin-zenrock-evm",
    "version": "0.1.0",
    "main": "dist/index.js",
    "type": "module",
    "types": "dist/index.d.ts",
    "dependencies": {
        "@elizaos/core": "workspace:*",
        "@bufbuild/protobuf": "^2.2.3",
        "tsup": "8.3.5",
        "wire": "link:@bufbuild/protobuf/wire"
    },
    "scripts": {
        "build": "tsup --format esm --dts",
        "dev": "tsup --format esm --dts --watch",
        "test": "vitest run",
        "clean": "rm -rf dist",
        "lint": "biome lint .",
        "lint:fix": "biome check --apply .",
        "format": "biome format .",
        "format:fix": "biome format --write ."
    },
    "publishConfig": {
        "access": "public"
    }
}
